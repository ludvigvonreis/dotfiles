#!/usr/bin/env bash

folder="/home/ludvig/wallpapers"

# If argument is given, use it
if [ -n "$1" ]; then
    image="$1"
else
    # Only try kitty image previews if we're actually inside kitty
    if [ -n "$KITTY_WINDOW_ID" ] && command -v kitty >/dev/null 2>&1; then
        image=$(ls "$folder" | fzf \
            --prompt="Select an image: " \
            --preview="kitty +kitten icat --clear --transfer-mode=memory --stdin=no --place=\${FZF_PREVIEW_COLUMNS}x\${FZF_PREVIEW_LINES}@0x0 \"$folder\"/{}" \
            --preview-window="right:60%" \
        )
    else
        # Fallback: no preview support
        image=$(ls "$folder" | fzf --prompt="Select an image: ")
    fi
 
    # If nothing selected, exit
    if [ -z "$image" ]; then
        echo "No image selected."
        exit 1
    fi
fi

img="$folder/$image"

matugen image "$img" --type scheme-rainbow
cp "$img" $HOME/.cache/background.png
# Run awww with full path
awww img "$img" \
  --transition-type grow \
  --transition-fps 144 \
  --transition-step 90 \
  --transition-duration 0.5

