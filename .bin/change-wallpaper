#!/usr/bin/env bash

folder="/home/ludvig/wallpapers"

# If argument is given, use it
if [ -n "$1" ]; then
    image="$1"
else
    # No argument, use fzf to select a file
    image=$(ls "$folder" | fzf --prompt="Select an image: ")
    
    # If nothing selected, exit
    if [ -z "$image" ]; then
        echo "No image selected."
        exit 1
    fi
fi

img="$folder/$image"

matugen image "$img" --type scheme-rainbow
cp "$img" $HOME/.cache/background.png
# Run awww with full path
awww img "$img" \
  --transition-type grow \
  --transition-fps 144 \
  --transition-step 90 \
  --transition-duration 0.5

