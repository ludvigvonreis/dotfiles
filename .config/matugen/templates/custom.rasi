/**
 * Merged Rofi Theme
 * Layout: adi1090x
 * Visual Style: Material-style (first theme)
 * Rofi Version: 1.7+
 */

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    display-filebrowser:        "";
    display-window:             "";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

/*****----- Color Tokens (from first theme) -----*****/
* {
    primary:                    #c0c1ff;
    primary-container:          {{colors.primary.default.hex}};
    on-primary-container:       #e1e0ff;

    secondary-container:        #454559;

    surface:                    rgba(19, 19, 24, 0.8);
    surface-container:          #1f1f25;
    surface-container-high:     #2a292f;

    on-surface:                 #e1e3e9;
    on-surface-variant:         #c7c5d0;

    outline:                    #918f9a;

    error:                      #ffb4ab;

    font: "FiraCode Nerd Font Mono 12";
}

/*****----- Global Aliases -----*****/
* {
    background:                @surface;
    background-alt:            @surface-container;
    foreground:                @on-surface;
    foreground-alt:            @on-surface-variant;

    selected:                  @primary-container;
    selected-foreground:       @on-primary-container;

    border-colour:             @outline;
    handle-colour:             @primary;
}

/*****----- Window (layout from second) -----*****/
window {
    transparency:              "real";
    location:                  center;
    anchor:                    center;
    fullscreen:                false;
    width:                     800px;

    margin:                    0px;
    padding:                   0px;
    border:                    0px;
    border-radius:             12px;
    background-color:          @background;
}

/*****----- Main Box -----*****/
mainbox {
    spacing:                   20px;
    padding:                   24px;
    border-radius:             12px;
    background-color:          transparent;
    children:                  [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    spacing:                   12px;
    padding:                   14px;
    border-radius:             10px;
    background-color:          @background-alt;
    text-color:                @foreground;
    children:                  [ "prompt", "entry" ];
}

prompt {
    background-color:          transparent;
    text-color:                @foreground;
}

entry {
    background-color:          transparent;
    text-color:                inherit;
    cursor:                    text;
    placeholder:               "Search";
    placeholder-color:         @foreground-alt;
}

/*****----- Listview (layout preserved) -----*****/
listview {
    columns:                   2;
    lines:                     7;
    cycle:                     true;
    dynamic:                   true;
    scrollbar:                 false;
    layout:                    vertical;
    fixed-height:              true;
    fixed-columns:             true;

    spacing:                   8px;
    padding:                   0px;
    background-color:          transparent;
    text-color:                @foreground;
}

/*****----- Scrollbar -----*****/
scrollbar {
    handle-width:              5px;
    handle-color:              @handle-colour;
    background-color:          @background-alt;
}

/*****----- Elements -----*****/
element {
    spacing:                   10px;
    padding:                   10px;
    border-radius:             10px;
    background-color:          transparent;
    text-color:                @foreground;
    cursor:                    pointer;
}

element normal.normal {
    background-color:          transparent;
    text-color:                @foreground-alt;
}

element alternate.normal {
    background-color:          transparent;
    text-color:                @foreground;
}

element selected.normal {
    background-color:          @selected;
    text-color:                #1f1f25;
}

element normal.urgent {
    background-color:          @error;
    text-color:                black;
}

/*****----- Icons & Text -----*****/
element-icon {
    size:                      32px;
    background-color:          transparent;
    text-color:                inherit;
}

element-text {
    background-color:          transparent;
    text-color:                inherit;
    vertical-align:            0.5;
    horizontal-align:          0.0;
}

/*****----- Mode Switcher -----*****/
mode-switcher {
    spacing:                   10px;
    background-color:          transparent;
}

button {
    padding:                   10px;
    border-radius:             8px;
    background-color:          @background-alt;
    text-color:                @foreground;
}

button selected {
    background-color:          @selected;
    text-color:                @selected-foreground;
}

/*****----- Messages -----*****/
message {
    background-color:          transparent;
    text-color:                @foreground;
}

textbox {
    padding:                   10px;
    border-radius:             8px;
    background-color:          @background-alt;
    text-color:                @foreground;
}

error-message {
    padding:                   12px;
    border-radius:             10px;
    background-color:          @background-alt;
    text-color:                @foreground;
}
